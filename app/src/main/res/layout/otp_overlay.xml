<?xml version="1.0" encoding="utf-8"?>
<dev.ertu.quietfilter.SwipeDismissLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/otp_overlay_background"
    android:elevation="10dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_otp_source"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/otp_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/overlay_otp_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@android:color/transparent"
            android:contentDescription="Dismiss"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            android:tint="@color/otp_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_otp_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="@color/otp_code"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/overlay_otp_copy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/otp_icon_button_background"
            android:contentDescription="Copy verification code"
            android:padding="9dp"
            android:src="@drawable/ic_copy"
            android:tint="@color/otp_button_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlay_otp_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/otp_text_secondary"
        android:textSize="11sp" />

</dev.ertu.quietfilter.SwipeDismissLayout>
